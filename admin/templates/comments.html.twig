{% extends 'partials/base.html.twig' %}

{% if admin.route %}
    {% set context = admin.page(true) %}
{% endif %}

{% block titlebar %}
    <h1><i class="fa fa-fw fa-file-text-o"></i> {{ "PLUGIN_COMMENTS.COMMENTS"|tu }}</h1>
{% endblock %}

{% block content %}
    <style>
        td.comments-actions {
            flex: 0.1;
        }

        .pages-list .row {
            padding-right: 1rem;
        }

        .comment-text {
            line-height: 1.5rem;
            display: inline-block;
        }

        .pages-list .row p.page-route {
            margin: 0px 0 10px 0px;
        }

        th { background: #d9d9d9; }

        .comment { flex: 3 }
        .details { flex: 1.5 }
        .comments-actions { flex: 0.5 }

        .center {
            margin: 0 auto;
            text-align: center;
            display: block;
        }

        .button:active { margin: 0 auto;}

        .comment-cid {
            color: #666;
            font-family: Menlo, Consolas, "Liberation Mono", monospace;
            font-size: 0.85em;
            margin-left: 0.35rem;
        }
    </style>

    {% set is_trash = grav.twig.comments_mode == 'trash' %}
    {% set commentsBaseUrl = grav.config.plugins.admin.route ~ '/comments' ~ (is_trash ? '/trash:1' : '') %}

    <script>
        $(function() {
            var currentPage = 0;
            var displayedCount = parseInt($('.totalRetrieved').first().text(), 10);
            if (isNaN(displayedCount)) {
                displayedCount = 0;
            }
            var isTrashMode = {{ is_trash ? 'true' : 'false' }};
            var commentsBaseUrlJs = '{{ commentsBaseUrl|e("js") }}';
            var commentsActionUrl = commentsBaseUrlJs;
            var adminNonce = '{{ admin.getNonce("admin-form") }}';
            var canDelete = {{ authorize('admin.comments') ? 'true' : 'false' }};
            var canRestore = {{ authorize('admin.comments') ? 'true' : 'false' }};
            var deleteButtonText = '{{ "PLUGINS.COMMENTS.DELETE"|t|e("js") }}';
            var deleteConfirmText = '{{ "PLUGINS.COMMENTS.DELETE_CONFIRM"|t|e("js") }}';
            var restoreButtonText = '{{ "PLUGINS.COMMENTS.RESTORE"|t|e("js") }}';
            var restoreConfirmText = '{{ "PLUGINS.COMMENTS.RESTORE_CONFIRM"|t|e("js") }}';

            function escHtml(value) {
                return $('<div/>').text(value == null ? '' : String(value)).html();
            }

            $(document).on('submit', 'form.js-delete-comment', function () {
                return confirm(deleteConfirmText);
            });

            $(document).on('submit', 'form.js-restore-comment', function () {
                return confirm(restoreConfirmText);
            });

            $(document).on('click', '.js__load-more', function(event) {
               event.preventDefault();

               $.ajax({
                   url: commentsBaseUrlJs + '/page:' + (currentPage + 1),
                   dataType: 'json',
                   cache: false
               })
                .done(function(response) {
                    if (response && response.error) {
                        alert(response.error);
                        return;
                    }

                    currentPage = parseInt(response.page);

                    response.comments.forEach(function(comment) {
                        var formClass = isTrashMode ? 'js-restore-comment' : 'js-delete-comment';
                        var taskValue = isTrashMode ? 'restoreTrashComment' : 'trashComment';
                        var buttonClass = isTrashMode ? 'button button-small' : 'button button-small button-danger';
                        var buttonText = isTrashMode ? restoreButtonText : deleteButtonText;

                        var formHtml = '';
                        if ((isTrashMode && canRestore) || (!isTrashMode && canDelete)) {
                            formHtml = '<form method="post" action="' + commentsActionUrl + '" class="' + formClass + '" style="display:inline">' +
                                '<input type="hidden" name="task" value="' + escHtml(taskValue) + '">' +
                                '<input type="hidden" name="cid" value="' + escHtml(comment.cid) + '">' +
                                '<input type="hidden" name="relPath" value="' + escHtml(comment.relPath) + '">' +
                                '<input type="hidden" name="admin-nonce" value="' + escHtml(adminNonce) + '">' +
                                '<button type="submit" class="' + buttonClass + '">' + escHtml(buttonText) + '</button>' +
                                '</form>';
                        }

                        $('.js__comments-container').append('<tr class="js-comment-row">' +
                                '<td class="e author">' + escHtml(comment.author) + '</td>' +
                                '<td class="v comment">' + escHtml(comment.text) + '</td>' +
                                '<td class="v details"><strong>Page</strong>: ' + escHtml(comment.pageTitle) + '<br>' +
                                '<strong>Date</strong>: ' + escHtml(comment.date) + '</td>' +
                                '<td class="v comments-actions">' + formHtml + '</td>' +
                            '</tr>');
                    })

                    var added = 0;
                    if (typeof response.totalRetrieved !== 'undefined') {
                        added = parseInt(response.totalRetrieved, 10);
                    }
                    if (!added && response.comments && response.comments.length) {
                        added = response.comments.length;
                    }

                    displayedCount += added;
                    $('.totalRetrieved').text(displayedCount);

                    var totalAvailable = parseInt(response.totalAvailable, 10) || 0;
                    if (totalAvailable) {
                        $('.totalAvailable').text(totalAvailable);
                        if (displayedCount >= totalAvailable) {
                            $('.js__load-more').hide();
                        }
                    }
                })
                .fail(function(jqxhr) {
                    console.error('Load more failed', jqxhr);
                    alert('Impossible de charger plus de commentaires.');
                });
            });
        });
    </script>

    <div class="form-tabs">
        <div class="tabs-nav">
            <a href="{{ grav.config.plugins.admin.route ~ '/comments' }}" class="{{ is_trash ? '' : 'active' }}">
                {{ "PLUGINS.COMMENTS.TAB_COMMENTS"|t }}
            </a>
            <a href="{{ grav.config.plugins.admin.route ~ '/comments/trash:1' }}" class="{{ is_trash ? 'active' : '' }}">
                {{ "PLUGINS.COMMENTS.TAB_TRASH"|t }}
            </a>
        </div>
    </div>

    <h1>{{ is_trash ? "PLUGINS.COMMENTS.TITLE_TRASH"|t : "PLUGINS.COMMENTS.TITLE_COMMENTS"|t }}</h1>

    <div class="admin-block">
        <table>
            <tbody class="js__comments-container">
                <tr class="h">
                    <th class="author">{{ "PLUGINS.COMMENTS.AUTHOR"|t }}</th>
                    <th class="comment">{{ "PLUGINS.COMMENTS.COMMENT"|t }}</th>
                    <th class="details">{{ "PLUGINS.COMMENTS.DETAILS"|t }}</th>
                    <th class="comments-actions">{{ "PLUGINS.COMMENTS.ACTIONS"|t }}</th>
                </tr>
                {% for comment in grav.twig.comments.comments %}
                    <tr class="js-comment-row">
                        <td class="author">{{comment.author}}</td>
                        <td class="comment">{{comment.text}}</td>
                        <td class="details"><strong>Page</strong>: {{comment.pageTitle}}<br>
                        <strong>Date</strong>: {{comment.date}}</td>
                        <td class="comments-actions">
                            {% if is_trash and authorize('admin.comments') %}
                                <form method="post" action="{{ commentsBaseUrl }}" class="js-restore-comment" style="display:inline">
                                    <input type="hidden" name="task" value="restoreTrashComment">
                                    <input type="hidden" name="cid" value="{{ comment.cid|e('html_attr') }}">
                                    <input type="hidden" name="relPath" value="{{ comment.relPath|e('html_attr') }}">
                                    <input type="hidden" name="admin-nonce" value="{{ admin.getNonce('admin-form')|e('html_attr') }}">
                                    <button type="submit" class="button button-small">
                                        {{ "PLUGINS.COMMENTS.RESTORE"|t }}
                                    </button>
                                </form>
                            {% elseif not is_trash and authorize('admin.comments') %}
                                <form method="post" action="{{ commentsBaseUrl }}" class="js-delete-comment" style="display:inline">
                                    <input type="hidden" name="task" value="trashComment">
                                    <input type="hidden" name="cid" value="{{ comment.cid|e('html_attr') }}">
                                    <input type="hidden" name="relPath" value="{{ comment.relPath|e('html_attr') }}">
                                    <input type="hidden" name="admin-nonce" value="{{ admin.getNonce('admin-form')|e('html_attr') }}">
                                    <button type="submit" class="button button-small button-danger">
                                        {{ "PLUGINS.COMMENTS.DELETE"|t }}
                                    </button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% if grav.twig.comments.totalRetrieved < grav.twig.comments.totalAvailable %}
            <button type="button" class="button center js__load-more">
                {{ "PLUGINS.COMMENTS.LOAD_MORE"|t }}
            </button>
        {% endif %}

        {% set shown = '<span class="totalRetrieved">' ~ (grav.twig.comments.totalRetrieved|default(0)) ~ '</span>' %}
        {% set total = '<span class="totalAvailable">' ~ (grav.twig.comments.totalAvailable|default(0)) ~ '</span>' %}
        <p class="center">{{ "PLUGINS.COMMENTS.SHOWING_COMMENTS"|t([shown, total])|raw }}</p>
    </div>

    {% if grav.twig.pages %}
        <h1>{{ is_trash ? "PLUGINS.COMMENTS.RECENTLY_DELETED_PAGES"|t : "PLUGINS.COMMENTS.RECENTLY_COMMENTED_PAGES"|t }}</h1>

        <div class="admin-block">
            <table>
                <tbody class="js__pages-container">
                    <tr class="h">
                        <th class="page">Page</th>
                        <th class="number-of-comments">Number of comments</th>
                        <th class="last-comment-date">Last commented on</th>
                    </tr>
                    {% for page in grav.twig.pages %}
                        <tr>
                            <td class="page">{{page.title}}</td>
                            <td class="number-of-comments">{{page.commentsCount}}</td>
                            <td class="last-comment-date">{{page.lastCommentDate}}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

{% endblock %}
